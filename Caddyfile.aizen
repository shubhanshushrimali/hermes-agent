# Hermes Agent — Aizen reverse proxy
# Serves the mobile PWA and proxies gateway / dashboard / code-server.
#
# Hostnames must match docker-compose.aizen.yml service names.
# Caddy injects API_SERVER_KEY so the PWA can call /api/* same-origin
# without storing the gateway key in the browser.

{
	admin off
}

:80 {
	# Gateway health (docker HEALTHCHECK and PWA probes)
	handle /health {
		reverse_proxy hermes-gateway:5005
	}
	handle /v1/health {
		reverse_proxy hermes-gateway:5005
	}

	# OpenAI-compatible API + native /api/chat session adapter
	handle /v1/* {
		reverse_proxy hermes-gateway:5005 {
			header_up Authorization "Bearer {$API_SERVER_KEY}"
		}
	}
	handle /api/* {
		reverse_proxy hermes-gateway:5005 {
			header_up Authorization "Bearer {$API_SERVER_KEY}"
		}
	}
	handle /ws/* {
		reverse_proxy hermes-gateway:5005 {
			header_up Authorization "Bearer {$API_SERVER_KEY}"
		}
	}

	# Full dashboard SPA
	handle /dashboard* {
		uri strip_prefix /dashboard
		reverse_proxy hermes-dashboard:9119
	}

	# VS Code in the browser
	handle /code* {
		uri strip_prefix /code
		reverse_proxy hermes-code-server:8080
	}

	# Mobile PWA (default)
	handle {
		root * /srv/pwa
		try_files {path} /index.html
		file_server
	}
}
